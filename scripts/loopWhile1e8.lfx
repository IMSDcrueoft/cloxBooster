var start = (clock() * 1000);
{
    var i = 0;
    while(i < 5e8){
        i = i + 1;
    }
}
print "while 1e8";
print ((clock() * 1000) - start);

start = (clock() * 1000);
{
    var i = 0;
    var a,b,c;
    while(i < 5e8){
        i = i + 1;
        // swap a and b
        c = a;
        a = b;
        b = c;
    }
}
print "Swap 1e8";
print ((clock() * 1000) - start);